# The web server, locally and in production. docs/https.md explains it, and
# tests/Unit/CaddyfileTest.php asserts every rule below.
#
# Plain HTTP, always. Locally docker-compose.yml sets SITE_ADDRESS to ":80":
# any hostname, on a loopback port. In production docker-compose.prod.yml sets
# the hostname, and the server's front Caddy (deploy/edge/, docs/edge.md) owns
# ports 80 and 443, gets and renews the certificate, redirects HTTP to HTTPS,
# and forwards the hostname here over the `edge` Docker network.
#
# Do NOT edit this file on the server. The next deploy overwrites it; change it
# here and release. deploy.sh validates it before anything restarts.
#
# Comments are whole lines only; CaddyfileTest strips them before reading.

# The visitor's address. Every request in production comes through the front
# Caddy, so the address Caddy sees is the front Caddy's; it sends the
# visitor's in X-Forwarded-For, having thrown away any the visitor sent.
# Trusted only from private networks, which nothing on the internet can reach
# this Caddy from: it publishes no public port.
{
	servers {
		trusted_proxies static private_ranges
	}
}

# Security headers for an authenticated app, on every response.
#
# `defer` writes them as the response leaves, after PHP has had its say, so
# nothing upstream can drop or overwrite one.
#
# HSTS pins the browser to HTTPS (ignored over plain HTTP, so harmless locally).
# nosniff: an upload served back cannot become a script.
# The content security policy runs scripts from the app only -- nothing inline,
# nothing eval'd -- and lets nothing frame the app, because a transparent
# overlay over a destructive button is the whole clickjacking attack. Styles
# allow inline because Vue binds style attributes.
# The referrer policy sends only the origin elsewhere, so an external link never
# learns which record was open.
(security_headers) {
	header {
		defer
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# The application.
http://{$SITE_ADDRESS} {
	import security_headers

	root * /var/www/src/public
	encode zstd gzip

	# Every byte allowed here is a byte php-fpm parses before any check runs.
	request_body {
		max_size 2MB
	}

	# .env, .git, .htaccess and friends.
	@dotfiles path_regexp /\.

	# One route, so the order below is the order things happen. Caddy otherwise
	# sorts directives by its own rules, and here the order is the security.
	route {
		# Cron is served on its own port (below), never through the site.
		respond /cron/* 404

		respond @dotfiles 404

		# Vite writes content-hashed filenames, so these never change.
		handle /assets/* {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# Everything else -- index.html, the API, every PHP response -- must
		# never be cached, or a deploy leaves clients pointing at asset
		# filenames that no longer exist.
		header Cache-Control "no-cache, no-store, must-revalidate"

		# Anything that is not a real file goes to index.php, which serves the
		# API and the SPA shell. REMOTE_ADDR is the visitor's, not the front
		# Caddy's, for login throttling and the site's form limit. The front
		# Caddy's X-Forwarded-Proto: https is what SessionCookie reads to mark
		# the session cookie Secure.
		php_fastcgi php:9000 {
			env REMOTE_ADDR {client_ip}
			read_timeout 300s
		}

		file_server
	}

	handle_errors {
		import security_headers
		respond "{err.status_code} {err.status_text}"
	}
}

# Cron only. docker-compose.prod.yml publishes this port on the server's
# loopback address and nowhere else, so nothing off the server can connect;
# the allow list is the second layer (loopback, and the Docker bridge where the
# port mapping delivers cron's curl), CronMiddleware's X-Cron-Secret the third.
http://:8081 {
	root * /var/www/src/public

	@outside not remote_ip 127.0.0.0/8 172.16.0.0/12 ::1/128

	route {
		respond @outside 403

		handle /cron/* {
			php_fastcgi php:9000 {
				read_timeout 300s
			}
		}

		respond 404
	}
}
