# Committed on purpose. Tests NEVER read .env and NEVER use Doppler.
# tests/bootstrap.php loads this file array-backed, refuses to run unless
# APP_ENV=testing and DB_NAME ends in _test, and only then populates $_ENV.
# The DB credentials below are the same defaults docker-compose.yml falls back
# to, so a fresh checkout needs no secrets to run the suite.

APP_ENV=testing
APP_DEBUG=true

DB_HOST=db
DB_PORT=3306
DB_NAME=waffle_test
DB_USER=waffle
DB_PASSWORD=waffle
DB_ROOT_PASSWORD=root

CRON_SECRET=test-secret

# Left empty on purpose: the CreateInitialOwner migration runs on every test
# run and must create nothing, or every test would start with a stray user.
FIRST_USERNAME=
FIRST_USER_PASSWORD=

# Dummy values for integrations go here as they are added. Every port is bound
# to a fake in tests, so nothing here is ever used to reach the network — they
# exist so config reads resolve and so signature-verification tests have a
# known key.
