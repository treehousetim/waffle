{
    "name": "treehousetim/waffle",
    "description": "Waffle Application Framework For Lazy Engineers: a test-first starting point for PHP 8.5 + Slim 4 + Vue 3 web apps, with Docker Compose, Doppler secrets and a one-server GitHub Actions deploy.",
    "type": "project",
    "keywords": ["skeleton", "starter", "slim", "vue", "pest", "docker", "doppler"],
    "license": "MIT",
    "authors": [
        {
            "name": "Tim Gallagher"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "delight-im/auth": "^9.0",
        "php-di/php-di": "^7.1",
        "php-di/slim-bridge": "^3.4",
        "robmorgan/phinx": "^0.16",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Installer\\": "tools/installer/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "Installer\\CreateProject::postCreate"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
